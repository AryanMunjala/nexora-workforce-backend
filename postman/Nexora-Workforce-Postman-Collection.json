{
  "info": {
    "name": "Nexora Workforce API",
    "description": "Postman requests for the Nexora Workforce Spring Boot REST API.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080/api" },
    { "key": "employeeId", "value": "1" }
  ],
  "item": [
    { "name": "Health check", "request": { "method": "GET", "url": "{{baseUrl}}/health" } },
    { "name": "List employees", "request": { "method": "GET", "url": "{{baseUrl}}/employees" } },
    { "name": "Search employees", "request": { "method": "GET", "url": "{{baseUrl}}/employees?search=engineering" } },
    { "name": "Get employee by ID", "request": { "method": "GET", "url": "{{baseUrl}}/employees/{{employeeId}}" } },
    {
      "name": "Create employee",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["if (pm.response.code === 201) { pm.collectionVariables.set('employeeId', pm.response.json().id); }"] } }],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"fullName\": \"Priya Sharma\",\n  \"email\": \"priya@example.com\",\n  \"department\": \"Engineering\",\n  \"jobTitle\": \"Software Engineer\",\n  \"status\": \"ACTIVE\"\n}", "options": { "raw": { "language": "json" } } },
        "url": "{{baseUrl}}/employees"
      }
    },
    {
      "name": "Update employee",
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"fullName\": \"Priya Sharma\",\n  \"email\": \"priya@example.com\",\n  \"department\": \"Engineering\",\n  \"jobTitle\": \"Senior Software Engineer\",\n  \"status\": \"ACTIVE\"\n}", "options": { "raw": { "language": "json" } } },
        "url": "{{baseUrl}}/employees/{{employeeId}}"
      }
    },
    { "name": "Delete employee", "request": { "method": "DELETE", "url": "{{baseUrl}}/employees/{{employeeId}}" } }
  ]
}
